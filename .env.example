# Sentinel — Environment Variables
# ====================================
# Copy this file to .env and fill in values, OR export directly in your shell.
#
# ALL OPTIONAL — Sentinel runs fully in deterministic mode without any keys.
# With a key, agents use real LLM reasoning for natural-language synthesis.

# Get a FREE Gemini API key (1,500 requests/day, no credit card):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Usage:
#   export GEMINI_API_KEY="AIza..."
#   python3 run_sentinel.py
